# API-токен для gRPC (Bearer). ОБЯЗАТЕЛЬНО задать непустым — иначе нода не стартует.
NODE_API_TOKEN=

# Адрес, на котором слушает gRPC API.
NODE_API_LISTEN=0.0.0.0:6237

# Путь к файлу персистентности конфига (в контейнере лежит на volume).
NODE_CONFIG_PATH=/var/lib/node/config.json

# TLS для gRPC API: пути к сертификату и ключу ВНУТРИ контейнера.
# Задайте оба — или уберите оба (тогда API будет без шифрования).
# Сертификаты из install/node.sh монтируются в /etc/node/certs.
NODE_TLS_CERT=/etc/node/certs/cert.pem
NODE_TLS_KEY=/etc/node/certs/key.pem
